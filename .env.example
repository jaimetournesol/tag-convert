# Optional environment values. The CLI does NOT automatically read .env.
# Prefer ~/.config/tag/config.json and a private TAG_ACCOUNT_FILE.
TAG_API_URL=https://your-tag-api.example.com
TAG_RELAY_URL=https://your-tag-relay.example.com
TAG_ACCOUNT_FILE=/absolute/private/tag-account.json
# TAG_TOKEN=   # alternative bearer token
# TAG_API_KEY= # alternative API key with the needed TAG scopes
